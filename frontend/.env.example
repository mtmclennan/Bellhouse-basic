# Bellhouse Excavating frontend — environment variables
# Copy to .env.local and fill in real values. Nothing here is a real secret.

# --- Email (Brevo) — required, primary lead notification path ---
BREVO_API_KEY=
EMAIL_FROM=
RECIPIENT_EMAIL=

# --- reCAPTCHA v3 (text-only forms: ContactForm, ServiceHeroQuoteForm, LandingQuoteForm) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# --- Cloudflare Turnstile + R2 (photo upload flow only) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPLOAD_SESSION_SECRET=
# R2 (S3-compatible) credentials — see src/lib/uploads/server/r2.ts for the exact var names it reads.

# --- Google Sheets (legacy/optional reporting destination — see docs/estivor-integration.md) ---
# Requires BOTH of:
#   1. GOOGLE_SHEET_ID below
#   2. GOOGLE_SERVICE_ACCOUNT_JSON below — the full service-account key JSON,
#      as a single-line string (e.g. `jq -c . google-service-account.json`).
#      Falls back to a google-service-account.json file at the project root
#      if this env var is unset (local-dev convenience only — that file is
#      gitignored and never deployed). Missing both is the #1 cause of
#      silent Sheets failures; see docs/estivor-integration.md.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Analytics / conversion tracking ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SMS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_EMAIL_CONVERSION_LABEL=

# --- Monitoring / synthetic health checks (src/app/api/monitor/*) ---
MONITOR_TOKEN=
MONITOR_TO_EMAIL=
MONITOR_LOG_DIR=
BREVO_WEBHOOK_TOKEN=
SLACK_WEBHOOK_URL=

# --- Next.js server actions ---
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# =========================================================================
# Estivor lead intake integration (src/lib/leadIntake/*)
# Inert by default — leave LEAD_INTAKE_MODE unset (or 'legacy') and nothing
# below is read or called. See docs/estivor-integration.md for the staged
# rollout plan.
# =========================================================================

# 'legacy' (default) | 'dual-write' | 'estivor-primary'
LEAD_INTAKE_MODE=legacy

# Server-to-server only — never exposed to the client.
ESTIVOR_INTAKE_API_URL=
ESTIVOR_INTAKE_API_KEY=
ESTIVOR_WORKSPACE_ID=
ESTIVOR_INTAKE_TIMEOUT_MS=8000
ESTIVOR_INTAKE_MAX_RETRIES=2
